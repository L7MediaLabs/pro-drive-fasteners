{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xmeurigbcyuihasyfbmw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "prodrive-mcp",
      "version": "0.1.0",
      "title": "Pro-Drive Fasteners MCP"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List products",
        "description": "List Pro-Drive Fasteners products from the public catalog. Optional keyword filter matches product name and specs (case-insensitive).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Optional keyword to filter by name/specs.",
              "type": "string"
            },
            "limit": {
              "description": "Max products to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Fetch a single Pro-Drive product by its catalog id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Product id from list_products."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "submit_contact_lead",
        "title": "Submit contact lead",
        "description": "Submit a sales/contact inquiry to Pro-Drive Fasteners. Creates a record in the contact submissions inbox.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "company": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "email": {
              "type": "string",
              "maxLength": 320,
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "phone": {
              "type": "string",
              "maxLength": 50
            },
            "interest": {
              "type": "string",
              "maxLength": 100
            },
            "message": {
              "type": "string",
              "maxLength": 5000
            }
          },
          "required": [
            "name",
            "company",
            "email"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
